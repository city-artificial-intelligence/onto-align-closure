     <!-- Core Rulewerk API and reasoning model -->
    <dependency>
        <groupId>org.semanticweb.rulewerk</groupId>
        <artifactId>rulewerk-core</artifactId>
        <version>${rulewerk.version}</version>
    </dependency>

    <!-- Parser for Rulewerk/Datalog syntax -->
    <dependency>
        <groupId>org.semanticweb.rulewerk</groupId>
        <artifactId>rulewerk-parser</artifactId>
        <version>${rulewerk.version}</version>
    </dependency>

    <!-- VLog reasoning backend -->
    <dependency>
        <groupId>org.semanticweb.rulewerk</groupId>
        <artifactId>rulewerk-vlog</artifactId>
        <version>${rulewerk.version}</version>
    </dependency>

    <!-- RDF integration -->
    <dependency>
        <groupId>org.semanticweb.rulewerk</groupId>
        <artifactId>rulewerk-rdf</artifactId>
        <version>${rulewerk.version}</version>
    </dependency>

    <!-- OWL API integration -->
    <dependency>
        <groupId>org.semanticweb.rulewerk</groupId>
        <artifactId>rulewerk-owlapi</artifactId>
        <version>${rulewerk.version}</version>
    </dependency>

    <!-- Graal backend/integration -->
    <dependency>
        <groupId>org.semanticweb.rulewerk</groupId>
        <artifactId>rulewerk-graal</artifactId>
        <version>${rulewerk.version}</version>
    </dependency>
    
    <dependency>
			<groupId>org.semanticweb.rulewerk</groupId>
			<artifactId>rulewerk-commands</artifactId>
			<version>${rulewerk.version}</version>
