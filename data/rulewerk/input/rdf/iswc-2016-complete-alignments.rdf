    <j.3:keyword rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Analysis of Linked Data</j.3:keyword>
    <dc:title>Aemoo: Linked Data exploration based on Knowledge Patterns</dc:title>
    <dc:subject rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Exploratory search</dc:subject>
    <j.13:maker rdf:resource="http://www.scholarlydata.org/person/andrea-giovanni-nuzzolese"/>
    <j.3:hasAuthorList rdf:resource="https://w3id.org/scholarlydata/inproceedings/iswc2016/paper/journal/journal-1/authorList"/>
    <rdf:type rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#InformationObject"/>
