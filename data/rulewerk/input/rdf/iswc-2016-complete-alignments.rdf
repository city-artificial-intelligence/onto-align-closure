    <j.3:isEventRelatedTo rdf:resource="http://data.semanticweb.org/conference/iswc/2016/paper/posterdemo/demo-65"/>
    <rdfs:label>Who-Does-What: A knowledge base of people's occupations and job activities</rdfs:label>
    <j.7:dtstart>2016-10-19T18:00:00</j.7:dtstart>
    <rdfs:label>Jonas Bulegon Gassen, Stefano Faralli, Simone Paolo Ponzetto and Jan Mendling</rdfs:label>
