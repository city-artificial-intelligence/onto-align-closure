  <rdf:Description rdf:about="http://data.semanticweb.org/conference/iswc/2016/paper/posterdemo/poster-85">
    <j.3:relatesToEvent rdf:resource="https://w3id.org/scholarlydata/event/iswc2016/iswc/2016/session/19-oct-poster-and-demo-session/talk/poster-85"/>
