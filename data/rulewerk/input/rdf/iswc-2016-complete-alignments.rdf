    <rdf:type rdf:resource="http://purl.org/spar/fabio/ProceedingsPaper"/>
    <dc:subject rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WordNet</dc:subject>
    <j.13:maker rdf:resource="http://www.scholarlydata.org/person/joanna-biega"/>
    <j.3:title>YAGO: a multilingual knowledge base from Wikipedia, Wordnet, and Geonames</j.3:title>
