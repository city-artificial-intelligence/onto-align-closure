  <rdf:Description rdf:about="http://www.scholarlydata.org/person/liang-zhao">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
    <owl:sameAs rdf:resource="http://www.scholarlydata.org/person/liang-zhao"/>
    <j.13:made rdf:resource="https://w3id.org/scholarlydata/inproceedings/iswc2016/paper/applications/application-29"/>
