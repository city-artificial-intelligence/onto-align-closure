  <rdf:Description rdf:about="https://w3id.org/scholarlydata/inproceedings/iswc2016/paper/posterdemo/demo-99">
    <j.13:maker rdf:resource="http://www.scholarlydata.org/person/femke-ongenae"/>
    <dc:subject rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Scalable</dc:subject>
    <dc:subject rdf:datatype="http://www.w3.org/2001/XMLSchema#string">User-friendly</dc:subject>
    <dc:creator rdf:resource="http://www.scholarlydata.org/person/pieter-bonte"/>
    <dc:subject rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Smart Office</dc:subject>
    <j.13:maker rdf:resource="http://www.scholarlydata.org/person/jelle-nelis"/>
    <owl:sameAs rdf:resource="http://data.semanticweb.org/conference/iswc/2016/paper/posterdemo/demo-99"/>
    <rdf:type rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Object"/>
    <j.3:title>User-Friendly and Scalable Platform for the Design of Intelligent IoT Services: a Smart Office Use Case</j.3:title>
    <rdf:type rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#SocialObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
    <rdfs:label>User-Friendly and Scalable Platform for the Design of Intelligent IoT Services: a Smart Office Use Case</rdfs:label>
    <dc:subject rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Internet of Things (IoT)</dc:subject>
    <j.13:maker rdf:resource="http://www.scholarlydata.org/person/filip-de-turck"/>
    <rdf:type rdf:resource="http://purl.org/spar/fabio/ProceedingsPaper"/>
    <j.3:isPartOf rdf:resource="http://www.scholarlydata.org/conference/iswc/2016/proceedings"/>
    <j.3:hasAuthorList rdf:resource="https://w3id.org/scholarlydata/inproceedings/iswc2016/paper/posterdemo/demo-99/authorList"/>
    <rdf:type rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#InformationObject"/>
    <j.3:keyword rdf:datatype="http://www.w3.org/2001/XMLSchema#string">User-friendly</j.3:keyword>
    <j.3:abstract>The Internet of Things (IoT) is starting to take a prevalent role in our daily lives. Smart offices that automatically adapt their environment to make life at the office as pleasant as possible, are slowly becoming reality.
In this paper we present a user-friendly semantic-based smart office platform that allows, through easy configuration, a personalized and comfortable experience at the office.</j.3:abstract>
    <j.2:abstract>The Internet of Things (IoT) is starting to take a prevalent role in our daily lives. Smart offices that automatically adapt their environment to make life at the office as pleasant as possible, are slowly becoming reality.
In this paper we present a user-friendly semantic-based smart office platform that allows, through easy configuration, a personalized and comfortable experience at the office.</j.2:abstract>
    <dc:creator rdf:resource="http://www.scholarlydata.org/person/femke-ongenae"/>
    <j.3:keyword rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Scalable</j.3:keyword>
