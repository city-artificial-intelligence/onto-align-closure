  <rdf:Description rdf:about="https://w3id.org/scholarlydata/inproceedings/iswc2016/paper/posterdemo/poster-100/authorList/item-7">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
