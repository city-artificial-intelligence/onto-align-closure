    <j.13:maker rdf:resource="http://www.scholarlydata.org/person/martin-ringsquandl"/>
    <j.3:isPartOf rdf:resource="http://www.scholarlydata.org/conference/iswc/2016/proceedings"/>
    <j.13:maker rdf:resource="http://www.scholarlydata.org/person/yavor-nenov"/>
