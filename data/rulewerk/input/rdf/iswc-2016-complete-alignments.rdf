  <rdf:Description rdf:about="https://w3id.org/scholarlydata/event/iswc2016/iswc/2016/session/19-oct-poster-and-demo-session/talk/demo-65">
    <rdf:type rdf:resource="https://w3id.org/scholarlydata/ontology/conference-ontology.owl#Talk"/>
    <j.13:name>2016-10-19T21:00:00</j.13:name>
    <owl:sameAs rdf:resource="http://data.semanticweb.org/conference/iswc/2016/session/19-oct-poster-and-demo-session/talk/demo-65"/>
    <j.3:description>Who-Does-What: A knowledge base of people's occupations and job activities</j.3:description>
    <j.3:name>2016-10-19T21:00:00</j.3:name>
