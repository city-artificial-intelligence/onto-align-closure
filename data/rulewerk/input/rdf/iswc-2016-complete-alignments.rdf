  <rdf:Description rdf:about="https://w3id.org/scholarlydata/person/christian-hennig">
    <owl:sameAs rdf:resource="http://data.semanticweb.org/person/christian-hennig"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
