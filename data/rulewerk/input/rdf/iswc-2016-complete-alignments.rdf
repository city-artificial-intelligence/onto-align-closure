    <rdf:type rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Object"/>
    <j.13:maker rdf:resource="http://www.scholarlydata.org/person/fernando-florenzano"/>
    <dc:creator rdf:resource="http://www.scholarlydata.org/person/denis-parra"/>
    <j.2:abstract>We demonstrate a visualisation aimed at facilitating SPARQL-fluent 
users to produce queries over a dataset they are not familiar with. 
This visualisation consists of a labelled graph whose nodes are the different types of entities in the RDF dataset, 
and where two types are related if entities of these types appear related in the RDF dataset. To avoid a visual overload when 
the number of types in a dataset is too big, the graph groups together all types that are subclass of a 
more general type, and users are given the option of navigating through this hierarchy of types, dividing type nodes 
into subtypes as they see fit. 
We illustrate our visualisation using the Linked Movie Database dataset, and offer as well the visualisation of DBpedia. 
</j.2:abstract>
    <j.13:maker rdf:resource="http://www.scholarlydata.org/person/denis-parra"/>
    <j.13:maker rdf:resource="http://www.scholarlydata.org/person/juan-l-reutter"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/scholarlydata/inproceedings/iswc2016/paper/research/research-88/authorList">
    <j.3:hasLastItem rdf:resource="https://w3id.org/scholarlydata/inproceedings/iswc2016/paper/research/research-88/authorList/item-2"/>
    <j.3:hasFirstItem rdf:resource="https://w3id.org/scholarlydata/inproceedings/iswc2016/paper/research/research-88/authorList/item-1"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdf:type rdf:resource="http://www.scholarlydata.org/ontology/conference-ontology.owl#List"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
