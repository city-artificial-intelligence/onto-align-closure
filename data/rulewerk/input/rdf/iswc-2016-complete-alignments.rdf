    <j.3:keyword rdf:datatype="http://www.w3.org/2001/XMLSchema#string">weighted ontology alignment</j.3:keyword>
    <dc:creator rdf:resource="http://www.scholarlydata.org/person/armen-inants"/>
    <j.3:title>Algebraic calculi for weighted ontology alignments</j.3:title>
