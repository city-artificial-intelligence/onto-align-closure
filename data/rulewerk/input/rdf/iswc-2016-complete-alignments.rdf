  <rdf:Description rdf:about="https://w3id.org/scholarlydata/inproceedings/iswc2016/paper/posterdemo/demo-37">
    <j.3:abstract>Ontology learning has been an important research area in the Semantic Web field in the last 20 years. Ontology learning systems generate domain models from data (typically text) using a combination of sophisticated methods. In this poster, we study the use of Google's word2vec to emulate a simple ontology learning system, and compare the results to an existing "traditional" ontology learning system.
</j.3:abstract>
    <dc:creator rdf:resource="http://www.scholarlydata.org/person/gerhard-wohlgenannt"/>
    <rdf:type rdf:resource="http://purl.org/spar/fabio/ProceedingsPaper"/>
    <dc:title>Using word2vec to Build a Simple Ontology Learning System</dc:title>
    <rdf:type rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#SocialObject"/>
    <j.2:abstract>Ontology learning has been an important research area in the Semantic Web field in the last 20 years. Ontology learning systems generate domain models from data (typically text) using a combination of sophisticated methods. In this poster, we study the use of Google's word2vec to emulate a simple ontology learning system, and compare the results to an existing "traditional" ontology learning system.
</j.2:abstract>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
