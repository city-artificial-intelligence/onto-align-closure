  <rdf:Description rdf:about="https://w3id.org/scholarlydata/inproceedings/iswc2016/paper/posterdemo/poster-11">
    <dc:creator rdf:resource="http://www.scholarlydata.org/person/yohei-yamane"/>
    <j.3:isPartOf rdf:resource="http://www.scholarlydata.org/conference/iswc/2016/proceedings"/>
    <j.13:maker rdf:resource="http://www.scholarlydata.org/person/kazunari-hashimoto"/>
    <dc:creator rdf:resource="http://www.scholarlydata.org/person/hiroshi-umemoto"/>
    <owl:sameAs rdf:resource="http://data.semanticweb.org/conference/iswc/2016/paper/posterdemo/poster-11"/>
    <j.3:keyword rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ontology</j.3:keyword>
    <j.13:maker rdf:resource="http://www.scholarlydata.org/person/masao-watanabe"/>
    <rdf:type rdf:resource="http://purl.org/spar/fabio/ProceedingsPaper"/>
    <dc:title>Working process quantification in factory using wearable sensor device and ontology-based stream data processing</dc:title>
    <dc:subject rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ontology</dc:subject>
    <j.3:hasAuthorList rdf:resource="https://w3id.org/scholarlydata/inproceedings/iswc2016/paper/posterdemo/poster-11/authorList"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
    <dc:creator rdf:resource="http://www.scholarlydata.org/person/seiya-inagi"/>
    <j.2:abstract>A method for quantifying working processes on manufacturing floors was established that uses a wearable sensor device and an ontology-based stream data processing system.
Using this method, the measurement of manufacturing process efficiency from sensor data extracted from such a device worn by workers on the job was confirmed at the Fuji Xerox factory.</j.2:abstract>
    <rdf:type rdf:resource="http://www.scholarlydata.org/ontology/conference-ontology.owl#InProceedings"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <dc:subject rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wearable device</dc:subject>
    <j.13:maker rdf:resource="http://www.scholarlydata.org/person/seiji-suzuki"/>
    <j.3:abstract>A method for quantifying working processes on manufacturing floors was established that uses a wearable sensor device and an ontology-based stream data processing system.
Using this method, the measurement of manufacturing process efficiency from sensor data extracted from such a device worn by workers on the job was confirmed at the Fuji Xerox factory.</j.3:abstract>
    <j.13:maker rdf:resource="http://www.scholarlydata.org/person/yohei-yamane"/>
    <j.3:title>Working process quantification in factory using wearable sensor device and ontology-based stream data processing</j.3:title>
    <j.3:keyword rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wearable device</j.3:keyword>
    <dc:subject rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IOT</dc:subject>
    <j.13:maker rdf:resource="http://www.scholarlydata.org/person/seiya-inagi"/>
    <dc:subject rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stream data processing</dc:subject>
    <rdfs:label>Working process quantification in factory using wearable sensor device and ontology-based stream data processing</rdfs:label>
