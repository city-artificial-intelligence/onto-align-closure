    <j.3:isPartOf rdf:resource="http://www.scholarlydata.org/conference/iswc/2016/proceedings"/>
    <j.3:keyword rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ontology matching</j.3:keyword>
