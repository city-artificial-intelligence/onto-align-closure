  <rdf:Description rdf:about="https://w3id.org/scholarlydata/event/iswc2016/iswc/2016/session/21-oct-parallel-session-8-enriching-data-sources/talk/application-21">
    <j.3:name>2016-10-21T16:50:00</j.3:name>
