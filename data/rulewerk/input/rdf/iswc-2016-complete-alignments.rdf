  <rdf:Description rdf:about="https://w3id.org/scholarlydata/inproceedings/iswc2016/paper/posterdemo/demo-36">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <j.13:maker rdf:resource="http://www.scholarlydata.org/person/ermyas-abebe"/>
    <j.3:abstract>In this paper, we propose the rst system, so-called Open Programming Knowledge Extraction (OPKE), to automatically extract knowledge from programming Question-Answering (QA) communities. OPKE is the rst step of building a programming-centric knowledge base. Data mining and Natural Language Processing techniques are leveraged to identify paraphrased questions and construct structured information. Preliminary evaluation shows the eectiveness of OPKE.</j.3:abstract>
    <rdf:type rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Object"/>
    <dc:subject rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Programming QA</dc:subject>
    <j.3:keyword rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Open IE</j.3:keyword>
    <j.9:authorList rdf:resource="https://w3id.org/scholarlydata/inproceedings/iswc2016/paper/posterdemo/demo-36/authorList"/>
    <j.3:keyword rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NLP</j.3:keyword>
    <dc:subject rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Open IE</dc:subject>
    <rdf:type rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#SocialObject"/>
    <dc:subject rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NLP</dc:subject>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
