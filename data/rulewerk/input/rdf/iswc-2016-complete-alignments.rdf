  <rdf:Description rdf:about="https://w3id.org/scholarlydata/inproceedings/iswc2016/paper/posterdemo/demo-115">
    <rdf:type rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#SocialObject"/>
    <dc:subject rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Prolog</dc:subject>
