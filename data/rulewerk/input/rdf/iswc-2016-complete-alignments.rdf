  <rdf:Description rdf:about="https://w3id.org/scholarlydata/inproceedings/iswc2016/paper/resource/resource-27/authorList/item-2">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
