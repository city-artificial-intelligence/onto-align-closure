  <rdf:Description rdf:about="http://data.semanticweb.org/conference/iswc/2016/paper/research/research-78">
    <j.3:relatesToEvent rdf:resource="https://w3id.org/scholarlydata/event/iswc2016/iswc/2016/session/20-oct-parallel-session-3-ontology-matching/talk/research-78"/>
