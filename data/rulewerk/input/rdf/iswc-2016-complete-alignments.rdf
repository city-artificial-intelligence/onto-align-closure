    <j.3:keyword rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Internet of Things (IoT)</j.3:keyword>
    <j.13:maker rdf:resource="http://www.scholarlydata.org/person/pieter-bonte"/>
