  <rdf:Description rdf:about="https://w3id.org/scholarlydata/inproceedings/iswc2016/paper/posterdemo/poster-100">
    <rdfs:label>Personalized robot interactions to intercept behavioral disturbances of people with dementia</rdfs:label>
    <dc:creator rdf:resource="http://www.scholarlydata.org/person/an-jacobs"/>
    <dc:creator rdf:resource="http://www.scholarlydata.org/person/pieter-simoens"/>
    <j.3:hasAuthorList rdf:resource="https://w3id.org/scholarlydata/inproceedings/iswc2016/paper/posterdemo/poster-100/authorList"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
    <j.3:keyword rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dementia</j.3:keyword>
    <j.13:maker rdf:resource="http://www.scholarlydata.org/person/shirley-elprama"/>
    <dc:creator rdf:resource="http://www.scholarlydata.org/person/filip-de-turck"/>
    <j.13:maker rdf:resource="http://www.scholarlydata.org/person/jelle-nelis"/>
    <j.2:abstract>People with Dementia (PwD) exhibit Behavioral Disturbances (BD) that can be alleviated by personalized interactions, revisiting memories and promoting comfort and quality of life. However, caregivers are unable to spend a lot of time on these interactions. This work-in-progress poster details the design and deployment of a semantic Internet of Robotic Things (IoRT) platform that enables personalized interactions of a robot with a PwD to reduce and intercept BDs.</j.2:abstract>
    <rdf:type rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Object"/>
