    <j.3:name>Adila A. Krisnadhi</j.3:name>
    <j.13:mbox_sha1sum>76fe98c9de14916373ed11a039db06c7fa0c9429</j.13:mbox_sha1sum>
    <rdf:type rdf:resource="http://www.scholarlydata.org/ontology/conference-ontology.owl#Person"/>
